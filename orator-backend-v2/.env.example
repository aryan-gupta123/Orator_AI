# Required. Never put this key in a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: otherwise Gemini transcribes audio and browser speech reads replies.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
PORT=8100
# Comma-separated allowed frontend origins when accessing the backend directly.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Optional free local mode. See the root README for model server setup.
ORATOR_PROVIDER=gemini
LOCAL_MODEL_URL=http://127.0.0.1:8091/v1
LOCAL_MODEL_NAME=qwen2.5-1.5b-instruct
LOCAL_WHISPER_MODEL=tiny.en
